// =====================================================
// 16) WIFI
// =====================================================
const char* getWiFiStatusText() {
  switch (WiFi.status()) {
    case WL_CONNECTED: return "CONNECTED";
    case WL_NO_SSID_AVAIL: return "SSID NOT FOUND";
    case WL_CONNECT_FAILED: return "CONNECTION FAILED";
    case WL_CONNECTION_LOST: return "CONNECTION LOST";
    case WL_DISCONNECTED: return "DISCONNECTED";
    case WL_IDLE_STATUS: return "CONNECTING";
    default: return "UNKNOWN";
  }
}

void startWiFi() {
  Serial.println();
  Serial.println("Starting WiFi...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  lastWiFiAttempt = millis();
}

void checkWiFi() {
  unsigned long now = millis();

  if (now - lastWiFiCheck >= WIFI_CHECK_INTERVAL) {
    lastWiFiCheck = now;

    Serial.print("WiFi Status: ");
    Serial.println(getWiFiStatusText());

    if (WiFi.status() == WL_CONNECTED) {
      Serial.print("IP Address: ");
      Serial.println(WiFi.localIP());

      Serial.print("WiFi RSSI: ");
      Serial.println(WiFi.RSSI());
    }
  }

  if (WiFi.status() != WL_CONNECTED &&
      now - lastWiFiAttempt >= WIFI_RECONNECT_INTERVAL) {

    Serial.println("WiFi disconnected! Reconnecting...");

    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    lastWiFiAttempt = now;
  }
}

// =====================================================
// 17) MQTT CONNECT
// =====================================================
void connectMQTT() {
  if (WiFi.status() != WL_CONNECTED ||
      mqttClient.connected()) {
    return;
  }

  unsigned long now = millis();

  if (now - lastMqttAttempt < MQTT_RECONNECT_INTERVAL) {
    return;
  }

  lastMqttAttempt = now;

  Serial.println("Connecting MQTT...");

  bool connected = mqttClient.connect(
    MQTT_CLIENT_ID,
    MQTT_USERNAME,
    MQTT_PASSWORD
  );

  if (connected) {
    Serial.println("MQTT CONNECTED!");
  } else {
    Serial.print("MQTT FAILED: ");
    Serial.println(mqttClient.state());
  }
}

// =====================================================
// 18) PUBLISH MQTT
// Only moisture and pump
// =====================================================
void publishToMQTT() {
  if (!pendingMqtt || !mqttClient.connected()) return;

  char payload[100];

  snprintf(
    payload,
    sizeof(payload),
    "{\"moisture\":%.1f,\"pump\":%d}",
    latestRecord.moisture,
    latestRecord.pumpState
  );

  Serial.println();
  Serial.println("Publishing to MQTT...");
  Serial.print("Payload: ");
  Serial.println(payload);

  if (mqttClient.publish(MQTT_TOPIC, payload)) {
    Serial.println("MQTT PUBLISH SUCCESS!");
    pendingMqtt = false;
  } else {
    Serial.println("MQTT PUBLISH FAILED - will retry");
  }
}

// =====================================================
// 19) THINGSPEAK UPLOAD
// Field 1 = Moisture
// Field 2 = Pump
// =====================================================
bool uploadToThingSpeak() {
  if (WiFi.status() != WL_CONNECTED) return false;

  WiFiClientSecure secureClient;
  secureClient.setInsecure();

  HTTPClient https;
  https.setTimeout(15000);

  String url = "https://api.thingspeak.com/update?api_key=";
  url += THINGSPEAK_API_KEY;
  url += "&field1=";
  url += String(latestRecord.moisture, 1);
  url += "&field2=";
  url += String(latestRecord.pumpState);

  if (!https.begin(secureClient, url)) {
    return false;
  }

  int httpCode = https.GET();
  String response = "";

  if (httpCode > 0) {
    response = https.getString();
    response.trim();

    Serial.print("ThingSpeak Entry ID: ");
    Serial.println(response);
  } else {
    Serial.println(https.errorToString(httpCode));
  }

  https.end();

  if (httpCode == 200 &&
      response.length() > 0 &&
      response != "0") {

    Serial.println("ThingSpeak Upload SUCCESS!");

    lastThingSpeakSuccess = millis();
    hasThingSpeakSuccess = true;

    return true;
  }

  Serial.println("ThingSpeak Upload FAILED");
  return false;
}

// =====================================================
// 20) SETUP
// =====================================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("======================================");
  Serial.println("HELTEC V2 SOIL RECEIVER");
  Serial.println("LoRa + WiFi + ThingSpeak + MQTT");
  Serial.println("TalkBack Pump Control Enabled");
  Serial.println("======================================");

  loadSettings();

  Serial.println("Starting LoRa...");

  SPI.begin(
    LORA_SCK,
    LORA_MISO,
    LORA_MOSI,
    LORA_SS
  );

  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);

  if (!LoRa.begin(LORA_FREQ)) {
    Serial.println("LoRa initialization FAILED!");
    while (true) delay(1000);
  }

  LoRa.setSpreadingFactor(LORA_SF);
  LoRa.setSignalBandwidth(LORA_BW);
  LoRa.setCodingRate4(LORA_CR);
  LoRa.setSyncWord(LORA_SYNC_WORD);
  LoRa.enableCrc();

  Serial.println("LoRa initialized successfully");

  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  mqttClient.setBufferSize(256);
  mqttClient.setKeepAlive(30);
  mqttClient.setSocketTimeout(5);

  startWiFi();

  Serial.println("Waiting for Heltec V3...");
}

// =====================================================
// 21) MAIN LOOP
// =====================================================
void loop() {
  unsigned long now = millis();

  // Receive LoRa
  int packetSize = LoRa.parsePacket();

  if (packetSize > 0) {
    String receivedData;
    receivedData.reserve(100);

    while (LoRa.available()) {
      receivedData += (char)LoRa.read();
    }

    Serial.print("Received: ");
    Serial.println(receivedData);

    if (parsePacketData(receivedData)) {
      recordCount++;

      pendingMqtt = true;

      lastPacketTime = millis();
      linkLostReported = false;

      displayRecord();
    } else {
      Serial.println("Invalid packet: ignored");
    }
  }

  now = millis();

  // Detect lost LoRa
  if (hasRecord &&
      now - lastPacketTime >= LINK_TIMEOUT &&
      !linkLostReported) {

    Serial.println("WARNING: No LoRa data for 25 seconds");
    linkLostReported = true;
  }

  // WiFi
  checkWiFi();

  if (WiFi.status() == WL_CONNECTED) {
    // MQTT
    if (!mqttClient.connected()) {
      connectMQTT();
    }

    mqttClient.loop();
    publishToMQTT();

    // TalkBack
    pollTalkBack();
  }

  // ThingSpeak upload
  bool uploadDue =
    !hasThingSpeakSuccess ||
    (now - lastThingSpeakSuccess >= THINGSPEAK_UPLOAD_INTERVAL);

  bool retryReady =
    (lastThingSpeakAttempt == 0 ||
     now - lastThingSpeakAttempt >= THINGSPEAK_RETRY_INTERVAL);

  if (hasRecord &&
      WiFi.status() == WL_CONNECTED &&
      uploadDue &&
      retryReady) {

    lastThingSpeakAttempt = now;

    Serial.println("ThingSpeak upload time");
    uploadToThingSpeak();
  }

  // Waiting
  if (!hasRecord &&
      now - lastStatusTime >= STATUS_INTERVAL) {

    lastStatusTime = now;
    Serial.println("Waiting for Heltec V3...");
  }

  delay(5);
}
