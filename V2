// =====================================================
// 7) SOIL CONDITION
// =====================================================
const char* getSoilCondition(float moisture) {
  if (moisture < 35.0) return "ดินแห้ง";
  if (moisture < 70.0) return "ดินชื้น";
  return "ดินเปียก";
}

const char* getSignalQuality(int rssi, float snr) {
  if (rssi >= -100 && snr >= -7.0) return "สัญญาณดี";
  return "สัญญาณอ่อน";
}

// =====================================================
// 8) READ LORA FIELD
// =====================================================
bool getField(
  const String& data,
  const String& key,
  String& output
) {
  int start = data.indexOf(key);
  if (start < 0) return false;

  start += key.length();

  int end = data.indexOf(',', start);
  if (end < 0) end = data.length();

  output = data.substring(start, end);
  output.trim();

  return output.length() > 0;
}

// =====================================================
// 9) CALCULATE PUMP WITH HYSTERESIS
// =====================================================
void calculatePumpState() {
  if (!hasRecord) return;

  if (calculatedPumpState == 0 &&
      latestRecord.moisture < pumpOnThreshold) {
    calculatedPumpState = 1;
  }
  else if (calculatedPumpState == 1 &&
           latestRecord.moisture >= pumpOffThreshold) {
    calculatedPumpState = 0;
  }

  latestRecord.pumpState = calculatedPumpState;
}

// =====================================================
// 10) SAVE SETTINGS
// =====================================================
void saveSettings() {
  preferences.begin("soil-settings", false);
  preferences.putFloat("on", pumpOnThreshold);
  preferences.putFloat("off", pumpOffThreshold);
  preferences.putInt("pump", calculatedPumpState);
  preferences.end();
}

void loadSettings() {
  preferences.begin("soil-settings", true);

  pumpOnThreshold = preferences.getFloat("on", 35.0);
  pumpOffThreshold = preferences.getFloat("off", 60.0);
  calculatedPumpState = preferences.getInt("pump", 0);

  preferences.end();

  if (pumpOnThreshold < 0 ||
      pumpOffThreshold > 100 ||
      pumpOnThreshold >= pumpOffThreshold) {
    pumpOnThreshold = 35.0;
    pumpOffThreshold = 60.0;
    calculatedPumpState = 0;
  }

  Serial.println("Loaded pump settings:");
  Serial.print("ON threshold: ");
  Serial.println(pumpOnThreshold);
  Serial.print("OFF threshold: ");
  Serial.println(pumpOffThreshold);
}

// =====================================================
// 11) APPLY ON/OFF COMMAND
// =====================================================
bool applyPumpSettings(String command) {
  command.trim();

  int onPosition = command.indexOf("ON=");
  int offPosition = command.indexOf("OFF=");

  if (onPosition < 0 || offPosition < 0) {
    Serial.println("Invalid TalkBack command");
    return false;
  }

  String onText = command.substring(onPosition + 3, offPosition);
  String offText = command.substring(offPosition + 4);

  onText.trim();
  offText.trim();

  float newOn = onText.toFloat();
  float newOff = offText.toFloat();

  if (newOn < 0 || newOn >= newOff || newOff > 100) {
    Serial.println("Invalid ON/OFF values");
    return false;
  }

  pumpOnThreshold = newOn;
  pumpOffThreshold = newOff;

  Serial.println();
  Serial.println("NEW PUMP SETTINGS RECEIVED");
  Serial.print("ON = ");
  Serial.println(pumpOnThreshold);
  Serial.print("OFF = ");
  Serial.println(pumpOffThreshold);

  calculatePumpState();
  saveSettings();

  if (hasRecord) {
    pendingMqtt = true;
    displayRecord();
  }

  return true;
}

// =====================================================
// 12) EXTRACT command_string FROM JSON
// =====================================================
String extractCommandString(const String& json) {
  int keyPosition = json.indexOf("\"command_string\"");
  if (keyPosition < 0) return "";

  int colonPosition = json.indexOf(':', keyPosition);
  if (colonPosition < 0) return "";

  int firstQuote = json.indexOf('"', colonPosition + 1);
  if (firstQuote < 0) return "";

  int secondQuote = json.indexOf('"', firstQuote + 1);
  if (secondQuote < 0) return "";

  return json.substring(firstQuote + 1, secondQuote);
}

// =====================================================
// 13) POLL THINGSPEAK TALKBACK
// =====================================================
void pollTalkBack() {
  if (WiFi.status() != WL_CONNECTED) return;

  unsigned long now = millis();

  if (now - lastTalkBackPoll < TALKBACK_POLL_INTERVAL) {
    return;
  }

  lastTalkBackPoll = now;

  WiFiClientSecure secureClient;
  secureClient.setInsecure();

  HTTPClient https;
  https.setTimeout(10000);

  String url = "https://api.thingspeak.com/talkbacks/";
  url += TALKBACK_ID;
  url += "/commands/execute.json";

  if (!https.begin(secureClient, url)) {
    Serial.println("TalkBack connection failed");
    return;
  }

  https.addHeader("Content-Type", "application/x-www-form-urlencoded");

  String body = "api_key=";
  body += TALKBACK_API_KEY;

  Serial.println();
  Serial.println("Checking ThingSpeak TalkBack...");

  int httpCode = https.POST(body);
  String response = "";

  if (httpCode > 0) {
    response = https.getString();
    response.trim();

    Serial.print("TalkBack HTTP: ");
    Serial.println(httpCode);

    if (httpCode == 200) {
      if (response.length() == 0 || response == "{}") {
        Serial.println("No new TalkBack command");
      } else {
        Serial.print("TalkBack response: ");
        Serial.println(response);

        String command = extractCommandString(response);

        if (command.length() > 0) {
          Serial.print("Command received: ");
          Serial.println(command);

          applyPumpSettings(command);
        }
      }
    }
  } else {
    Serial.print("TalkBack error: ");
    Serial.println(https.errorToString(httpCode));
  }

  https.end();
}

// =====================================================
// 14) PARSE LORA PACKET
// V3 sends RAW,MOISTURE,PUMP
// V2 ignores V3 PUMP and calculates its own
// =====================================================
bool parsePacketData(const String& data) {
  String rawText;
  String moistureText;

  if (!getField(data, "RAW=", rawText) ||
      !getField(data, "MOISTURE=", moistureText)) {
    return false;
  }

  int raw = rawText.toInt();
  float moisture = moistureText.toFloat();

  if (raw < 0 || raw > 4095) return false;
  if (moisture < 0 || moisture > 100) return false;

  latestRecord.rawValue = raw;
  latestRecord.moisture = moisture;
  latestRecord.rssi = LoRa.packetRssi();
  latestRecord.snr = LoRa.packetSnr();
  latestRecord.receivedAt = millis();

  hasRecord = true;

  calculatePumpState();

  latestRecord.pumpState = calculatedPumpState;

  return true;
}

